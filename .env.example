# Optional alternative to `modal token set`; see README.md.
# Copy this file to .env and replace the placeholders in .env only.
# Keep .env private. Commit only this placeholder template.
# .env is not loaded automatically; use `dotenv -f .env run -- modal ...`.

MODAL_TOKEN_ID=replace_with_your_modal_token_id
MODAL_TOKEN_SECRET=replace_with_your_modal_token_secret

# The public demo needs no Hugging Face token.
# For private models, use a named Modal Secret as described in README.md.
